# E2E(live) 설정 — 복사해서 .env.e2e 로 저장하세요. (.env.e2e 는 git 에 올라가지 않습니다)
# E2E_API_BASE_URL 이 비어 있으면 live 스위트는 실행 목록에서 빠지고 mock 스위트만 실행됩니다.

# 실제 백엔드 주소 (끝에 / 없이)
E2E_API_BASE_URL=http://localhost:8080

# 주입할 백엔드 인증 쿠키 (카카오 2단계 인증 때문에 로그인은 자동화하지 않습니다)
# 1. npm run dev 로 앱을 띄워 같은 백엔드로 카카오 로그인
# 2. 개발자 도구 > Network > 백엔드 API 요청(예: upcoming) 선택 > Request Headers 의 cookie 값을 통째로 복사
# 3. 아래에 따옴표로 감싸서 붙여 넣기 (예: "audigo_access_token=eyJ...; audigo_refresh_token=AUDIGO_REFRESH_...")
#    쿠키 이름까지 정확히 적어야 합니다. 리프레시 토큰만 넣어도 됩니다(첫 요청에서 재발급).
E2E_AUTH_COOKIES=

# (선택) 이전 기기 세션 — 단일 기기 정책 확인용(LIVE-SESS-05). 넣지 않으면 해당 테스트만 skip 됩니다.
E2E_AUTH_COOKIES_PREV=

# (선택) 실제 여행 생성 테스트(LIVE-ASY-01, LIVE-CONC-01) 실행 여부 — LLM 호출 · DB 저장이 발생합니다.
E2E_LIVE_GENERATE=false

# (선택) E2E 용 Vite 개발 서버 포트 (기본 5174). 백엔드 요청은 Vite 프록시를 거치므로 백엔드 CORS 설정은 필요 없습니다.
# E2E_PORT=5174

# (선택) 실제 AI 생성 대기 시간(ms)
# E2E_GENERATION_TIMEOUT_MS=180000